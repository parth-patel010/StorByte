{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storbyte",
  "version": "0.1.0",
  "identifier": "com.storbyte.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Storbyte",
        "label": "main",
        "width": 1040,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["storbytelink"],
        "name": "StorbyteLink",
        "description": "Storbyte zero-bit cloud link",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {}
}
